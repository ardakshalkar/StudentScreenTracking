# Replace both values; do not commit your .env.
TEACHER_PASSWORD=replace-with-a-long-unique-password
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Local Python + Vite development uses http://localhost:5173.
# Docker defaults to https://localhost (trust Caddy's local CA for development).
PUBLIC_ORIGIN=https://localhost
SITE_ADDRESS=localhost
# Optional trusted-LAN demo: ALLOW_LAN_HTTP=true, STUDENT_AUTH_MODE=code,
# PUBLIC_ORIGIN=http://192.168.1.20:5173 (use your teacher computer's private IP).
ALLOW_LAN_HTTP=false
RETENTION_DAYS=30
# Optional comma-separated Chrome extension IDs from chrome://extensions.
# Recommended in production. Blank permits any extension ID with valid student credentials.
EXTENSION_IDS=
# Set google to REQUIRE Google sign-in and enforce the exact domain allowlist.
# code keeps the original name/ID + classroom-code flow for local development.
STUDENT_AUTH_MODE=code
STUDENT_ALLOWED_DOMAINS=
STUDENT_GOOGLE_CLIENT_ID=
STUDENT_GOOGLE_CLIENT_SECRET=
# Optional OAuth web application credentials; enable Drive API in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key, generated using the command in README; keep stable and secret.
TOKEN_ENCRYPTION_KEY=
