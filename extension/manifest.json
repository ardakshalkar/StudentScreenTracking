{
  "manifest_version": 3,
  "name": "Classroom Screen Sharing",
  "description": "Share a chosen screen or application window with your active classroom. No camera, microphone or audio.",
  "version": "1.0.2",
  "minimum_chrome_version": "116",
  "permissions": ["desktopCapture", "storage", "identity"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Classroom sharing — open controls", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
